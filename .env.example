# Optional for loopback-only development. Required before exposing L.E.O. remotely.
LEO_API_TOKEN=
# Comma-separated exact browser origins and server hostnames for remote deployments.
LEO_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:4321,http://127.0.0.1:4321
LEO_ALLOWED_HOSTS=localhost,127.0.0.1
# Compose database password. Database is not exposed on a host port.
LEO_DB_PASSWORD=leo-local-development
# Without this variable, local development uses .leo/leo.db (SQLite).
# LEO_DATABASE_URL=postgresql+psycopg://leo:password@localhost:5432/leo
# Optional Fernet key. Otherwise .leo/secret.key is created with owner-only permissions.
# Back up this key together with the database; losing it makes saved API keys unreadable.
# LEO_ENCRYPTION_KEY=
# Secret for the bundled SearXNG search service (any long random string).
# SEARXNG_SECRET=
