# Optional for loopback-only development. Required before exposing L.E.O. remotely.
LEO_API_TOKEN=
# Comma-separated exact browser origins and server hostnames for remote deployments.
LEO_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:4321,http://127.0.0.1:4321
LEO_ALLOWED_HOSTS=localhost,127.0.0.1
# Let anyone create an account (true/false). Off: only the first user, or an admin, can add accounts.
LEO_ALLOW_REGISTRATION=
# Compose database password. Database is not exposed on a host port.
LEO_DB_PASSWORD=leo-local-development
# Without this variable, local development uses .leo/leo.db (SQLite).
# LEO_DATABASE_URL=postgresql+psycopg://leo:password@localhost:5432/leo
# Optional Fernet key. Otherwise .leo/secret.key is created with owner-only permissions.
# Back up this key together with the database; losing it makes saved API keys unreadable.
# LEO_ENCRYPTION_KEY=
# Password L.E.O. uses for its 9Router container (account sign-in). Compose gives both services the same value;
# 9Router has no host port, so only L.E.O.'s containers can use it. Change it any time, then `docker compose up -d`.
LEO_9ROUTER_PASSWORD=leo-local-development
# Secret for the bundled SearXNG search service (any long random string).
# SEARXNG_SECRET=
# Shared secret between the API/worker and sandboxd (agent mode). sandboxd has no host port; change it anyway
# when other containers run on the same Docker host.
LEO_SANDBOX_TOKEN=leo-local-development
# Per-sandbox limits for agent mode, and extra hosts the sandbox egress proxy may reach (comma separated).
# LEO_SANDBOX_MEMORY=2g
# LEO_SANDBOX_CPUS=2
# LEO_EGRESS_ALLOW_EXTRA=
# Stronger isolation: install gVisor on the Docker host, then set LEO_SANDBOX_RUNTIME=runsc.
# LEO_SANDBOX_RUNTIME=
