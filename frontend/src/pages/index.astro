---
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import Icon from '../components/Icon.astro';
import '../styles/global.css';
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="L.E.O — LLM Efficiency Orchestrator. A simple space for your next conversation." />
    <meta name="theme-color" content="#151515" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>L.E.O</title>
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem('leo-theme') === 'light' ? 'light' : 'dark'; } catch {}
    </script>
  </head>
  <body class="sidebar-collapsed">
    <div class="ambient-background" aria-hidden="true"></div>
    <a class="skip-link" href="#prompt">Skip to message</a>
    <button class="sidebar-scrim" id="sidebar-scrim" aria-label="Close conversations" tabindex="-1"></button>
    <aside class="sidebar" id="sidebar" aria-label="Conversations" inert>
      <div class="sidebar-heading">
        <h2>Chats</h2>
        <button class="icon-button" id="collapse-sidebar" title="Hide chats" aria-label="Hide chats"><Icon name="panel" size={17} /></button>
      </div>
      <button class="new-chat-button" id="new-chat"><Icon name="plus" size={15} /><span>New chat</span><kbd class="shortcut" data-key="K"></kbd></button>
      <button class="sidebar-search" id="search-chats"><Icon name="search" size={15} /><span>Search chats</span><kbd class="shortcut" data-key="/"></kbd></button>
      <section class="history-section" aria-label="Recent chats">
        <div id="history-list" class="history-list"></div>
        <p class="history-empty" id="history-empty">No chats yet. Your conversations will appear here.</p>
      </section>
      <div class="sidebar-footer">
        <a class="nav-button" href="/usage"><Icon name="chart" size={15} /><span>Usage</span></a>
        <button class="nav-button" id="sidebar-settings"><Icon name="settings" size={15} /><span>Settings</span></button>
        <p class="sidebar-status"><span class="status-dot" id="sidebar-dot"></span><span id="sidebar-status">Connecting…</span></p>
      </div>
      <template id="icon-trash"><Icon name="trash" size={14} /></template>
    </aside>
    <div class="app-shell">
      <header class="topbar">
        <div class="header-left">
          <button id="open-sidebar" class="icon-button" title="Conversations" aria-label="Open conversations" aria-expanded="false" aria-controls="sidebar"><Icon name="panel" size={18} /></button>
          <a class="brand" href="/" aria-label="L.E.O home">L.E.O</a>
          <span id="conversation-title" class="conversation-title"></span>
        </div>
        <div class="header-actions">
          <button class="icon-button" id="header-new-chat" title="New chat" aria-label="New chat"><Icon name="plus" size={19} /></button>
          <button class="settings-button" id="toggle-usage" title="Token and context usage for this chat" aria-controls="usage-panel" aria-expanded="false"><Icon name="chart" size={17} /><span>Usage</span></button>
          <button class="settings-button" id="open-settings" aria-haspopup="dialog"><Icon name="settings" size={17} /><span>Settings</span></button>
        </div>
      </header>
      <main id="main">
        <section class="welcome" id="welcome" aria-labelledby="welcome-heading">
          <h1 id="welcome-heading">What’s on your mind?</h1>
          <p class="welcome-caption">Your models. One thoughtful answer.</p>
          <button class="setup-link" id="connect-models">Connect your first model <span aria-hidden="true">↗</span></button>
        </section>
        <section class="messages" id="messages" aria-label="Conversation" aria-live="polite" aria-relevant="additions" hidden></section>
        <section class="run-panel" id="run-panel" aria-label="Run progress" hidden>
          <div class="run-heading"><span class="status-dot" id="status-dot"></span><span id="run-status" role="status">Ready</span><button class="secondary-button" id="stop-run" hidden>Stop</button></div>
          <div class="usage-line" id="run-usage"></div>
          <details><summary>Run activity</summary><ol id="run-events"></ol></details>
        </section>
        <div class="composer-area" id="composer-area">
          <form class="composer" id="chat-form">
            <label class="sr-only" for="prompt">Your message to L.E.O</label>
            <textarea id="prompt" name="prompt" placeholder="Message L.E.O…" rows="1" maxlength="12000"></textarea>
            <div class="composer-row">
              <label for="composer-mode" class="sr-only">Orchestration mode</label>
              <select id="composer-mode" title="Orchestration mode"><option value="auto">Auto · L.E.O. decides</option><option value="quick">Quick · one answer</option><option value="reviewed">Reviewed · generate + review</option><option value="deep">Deep · plan + review</option></select>
              <button type="button" id="search-toggle" class="search-toggle" aria-pressed="false" title="Search the web for this message (otherwise L.E.O. decides)"><Icon name="globe" size={15} /><span>Search</span></button>
              <button type="button" id="context-meter" class="context-meter" title="Context used by the latest call in this conversation" aria-controls="usage-panel" hidden><span class="meter"><span></span></span><span id="context-text"></span></button>
              <button class="send-button" id="send-button" type="submit" aria-label="Send message" title="Send message" disabled><Icon name="arrow" size={18} /><span class="stop-square" hidden></span></button>
            </div>
          </form>
          <p class="composer-foot"><span id="connection-status">Connecting…</span><span id="composer-note">Connect a local model or API in Settings.</span></p>
        </div>
      </main>
    </div>
    <aside class="usage-panel" id="usage-panel" aria-labelledby="usage-panel-heading" hidden>
      <div class="sidebar-heading">
        <h2 id="usage-panel-heading">This chat</h2>
        <button class="icon-button" id="close-usage" title="Close usage" aria-label="Close usage"><Icon name="close" size={18} /></button>
      </div>
      <p class="field-hint" id="usage-panel-empty">Start or open a conversation to see its token and context usage.</p>
      <div id="usage-panel-body" class="panel-body" hidden></div>
      <a class="setup-link panel-link" href="/usage/">Usage across all chats</a>
    </aside>
    <aside class="canvas-panel" id="canvas-panel" aria-labelledby="canvas-title" hidden>
      <div class="canvas-bar">
        <strong id="canvas-title">Preview</strong>
        <div class="canvas-tabs" role="tablist" aria-label="Canvas view">
          <button role="tab" id="canvas-tab-preview" aria-selected="true" aria-controls="canvas-frame">Preview</button>
          <button role="tab" id="canvas-tab-code" aria-selected="false" aria-controls="canvas-code">Code</button>
        </div>
        <div class="canvas-actions">
          <button class="icon-button" id="canvas-wide" title="Desktop width" aria-label="Show the page at desktop width" aria-pressed="false"><Icon name="expand" size={16} /></button>
          <button class="icon-button" id="canvas-reload" title="Run again" aria-label="Run the page again"><Icon name="refresh" size={16} /></button>
          <button class="icon-button" id="canvas-open" title="Open in a new tab" aria-label="Open in a new tab"><Icon name="diagonal" size={16} /></button>
          <button class="icon-button" id="canvas-download" title="Download .html" aria-label="Download HTML file"><Icon name="down" size={16} /></button>
          <button class="icon-button" id="canvas-close" title="Close preview" aria-label="Close preview"><Icon name="close" size={17} /></button>
        </div>
      </div>
      <p class="canvas-status" id="canvas-status" role="status"></p>
      <iframe id="canvas-frame" title="Generated page preview" sandbox="allow-scripts allow-forms allow-modals" referrerpolicy="no-referrer"></iframe>
      <pre id="canvas-code" class="canvas-code" hidden><code></code></pre>
    </aside>
    <dialog id="search-dialog" class="dialog search-dialog" aria-labelledby="search-heading">
      <div class="dialog-heading"><h2 id="search-heading">Search conversations</h2><button class="icon-button" data-close-dialog aria-label="Close search"><Icon name="close" size={18} /></button></div>
      <label class="search-field"><Icon name="search" size={17} /><input id="search-input" type="search" aria-label="Search conversations" placeholder="Search…" autocomplete="off" /></label>
      <div id="search-results" class="search-results"></div>
    </dialog>
    <dialog id="settings-dialog" class="dialog settings-dialog" aria-labelledby="settings-heading">
      <div class="dialog-heading"><h2 id="settings-heading">Settings</h2><button class="icon-button" data-close-dialog aria-label="Close settings"><Icon name="close" size={18} /></button></div>
      <div class="settings-layout">
        <div class="settings-tabs" role="tablist" aria-label="Settings sections" aria-orientation="vertical">
          <span class="tab-marker" aria-hidden="true"></span>
          <button type="button" role="tab" id="tab-models" aria-controls="panel-models" aria-selected="true">Models</button>
          <button type="button" role="tab" id="tab-skills" aria-controls="panel-skills" aria-selected="false" tabindex="-1">Skills</button>
          <button type="button" role="tab" id="tab-routing" aria-controls="panel-routing" aria-selected="false" tabindex="-1">Routing</button>
          <button type="button" role="tab" id="tab-search" aria-controls="panel-search" aria-selected="false" tabindex="-1">Web search</button>
          <button type="button" role="tab" id="tab-limits" aria-controls="panel-limits" aria-selected="false" tabindex="-1">Limits</button>
          <button type="button" role="tab" id="tab-general" aria-controls="panel-general" aria-selected="false" tabindex="-1">General</button>
        </div>
        <div class="settings-panels">
          <section class="settings-panel" role="tabpanel" id="panel-models" aria-labelledby="tab-models">
            <div class="panel-intro"><p>Add a provider once, then choose which of its models to use.</p><button class="secondary-button" id="add-connection">Add provider</button></div>
            <form id="provider-form" class="provider-form" hidden>
              <input id="provider-id" type="hidden" />
              <div class="field-grid">
                <label>Provider<select id="provider-preset"></select></label>
                <label>Name<input id="provider-name" maxlength="80" required placeholder="My coding model" /></label>
              </div>
              <p class="field-hint" id="provider-hint"></p>
              <label>Model ID<input id="provider-model" list="model-catalog" required placeholder="Exact model name" maxlength="160" /></label>
              <datalist id="model-catalog"></datalist>
              <label>API key<input id="provider-key" type="password" autocomplete="new-password" placeholder="Optional for local servers" /></label>
              <label id="provider-key-from-row" hidden>Or reuse a saved key<select id="provider-key-from"><option value="">No, use the key above</option></select></label>
              <div class="field-grid">
                <label>Strength<select id="provider-tier"><option value="light">Light: small or fast</option><option value="standard">Standard</option><option value="strong">Strong: top model</option></select></label>
                <label class="check-label inline-check"><input id="provider-reasoning" type="checkbox" /> Thinks before answering</label>
              </div>
              <fieldset class="skill-picker"><legend>Good at</legend><div id="provider-skills" class="skill-options"></div></fieldset>
              <label class="check-label"><input id="provider-enabled" type="checkbox" checked /> Use this model</label>
              <details class="advanced" id="provider-advanced">
                <summary>Address, cost, and limits</summary>
                <label>API base URL<input id="provider-url" type="url" required placeholder="http://localhost:11434/v1" /></label>
                <div class="field-grid">
                  <label>Protocol<select id="provider-protocol"><option value="openai">Chat Completions</option><option value="responses">OpenAI Responses</option><option value="anthropic">Anthropic Messages</option></select></label>
                  <label>Output parameter<select id="provider-token-param"><option value="max_tokens">max_tokens</option><option value="max_completion_tokens">max_completion_tokens</option></select></label>
                  <label>Context window<input id="provider-context" type="number" value="32768" min="1024" max="2000000" required /></label>
                  <label>Priority (lower first)<input id="provider-priority" type="number" value="10" min="0" max="100" required /></label>
                </div>
                <div class="check-row">
                  <label class="check-label"><input id="provider-local" type="checkbox" /> Local server</label>
                  <label class="check-label"><input id="provider-free" type="checkbox" /> No API charge</label>
                  <label class="check-label"><input id="provider-clear-key" type="checkbox" /> Remove saved key</label>
                </div>
                <div class="field-grid">
                  <label>Input $ / 1M tokens<input id="provider-input-price" type="number" step="any" min="0" max="10000" placeholder="Paid models" /></label>
                  <label>Output $ / 1M tokens<input id="provider-output-price" type="number" step="any" min="0" max="10000" placeholder="Paid models" /></label>
                </div>
              </details>
              <p class="form-feedback" id="provider-feedback" role="status"></p>
              <div class="form-actions">
                <button type="button" class="text-button danger" id="remove-provider">Remove</button>
                <button type="button" class="secondary-button" id="check-provider">Check</button>
                <button type="button" class="secondary-button" id="cancel-provider">Cancel</button>
                <button type="submit" class="primary-button">Save</button>
              </div>
            </form>
            <div id="provider-list" class="provider-list"></div>
            <section id="discover-panel" class="discover-panel" aria-labelledby="discover-title" hidden>
              <div class="section-heading"><h3 id="discover-title">Models this key can use</h3><button type="button" class="text-button" id="discover-close">Close</button></div>
              <p class="field-hint" id="discover-hint"></p>
              <div id="discover-list" class="discover-list"></div>
              <label class="check-label"><input id="discover-check" type="checkbox" checked /> Test each model first and skip ones the key can't use</label>
              <p class="form-feedback" id="discover-feedback" role="status"></p>
              <div class="form-actions"><button type="button" class="secondary-button" id="discover-none">Select none</button><button type="button" class="primary-button" id="discover-add">Add selected</button></div>
            </section>
          </section>
          <section class="settings-panel" role="tabpanel" id="panel-skills" aria-labelledby="tab-skills" hidden>
            <div class="panel-intro"><p>Each task is matched to a skill by keywords and sent to a model that has it.</p><button class="secondary-button" id="add-skill">Add skill</button></div>
            <form id="skill-form" class="provider-form" hidden>
              <input id="skill-id" type="hidden" />
              <div class="field-grid">
                <label>Name<input id="skill-name" maxlength="60" required placeholder="Data analysis" /></label>
                <label>Description<input id="skill-description" maxlength="300" placeholder="What tasks belong here" /></label>
              </div>
              <label>Keywords, comma separated<input id="skill-keywords" placeholder="pandas, dataframe, chart" /></label>
              <label>Instructions added to the prompt<textarea id="skill-instructions" rows="3" maxlength="4000"></textarea></label>
              <label class="check-label"><input id="skill-enabled" type="checkbox" checked /> Use this skill</label>
              <p class="form-feedback" id="skill-feedback" role="status"></p>
              <div class="form-actions">
                <button type="button" class="text-button danger" id="remove-skill">Remove</button>
                <button type="button" class="secondary-button" id="cancel-skill">Cancel</button>
                <button type="submit" class="primary-button">Save</button>
              </div>
            </form>
            <div id="skill-list" class="skill-list"></div>
          </section>
          <form id="orchestration-form" class="orchestration-form">
            <section class="settings-panel" role="tabpanel" id="panel-routing" aria-labelledby="tab-routing" hidden>
              <div class="panel-intro"><p>How L.E.O. picks a model for each task.</p></div>
              <fieldset class="choice-list">
                <legend>Model choice</legend>
                <label class="choice"><input type="radio" name="routing" value="auto" /><span><strong>Auto <em>Recommended</em></strong><small>Considers every model you turned on. Picks one that fits the task, then the cheapest: free models cost nothing, paid ones are priced from the tokens they actually use.</small></span></label>
                <label class="choice"><input type="radio" name="routing" value="free_first" /><span><strong>Free first</strong><small>Tries up to 3 free models before any paid one.</small></span></label>
                <label class="choice"><input type="radio" name="routing" value="local_first" /><span><strong>Local first</strong><small>Prefers models running on this computer.</small></span></label>
                <label class="choice"><input type="radio" name="routing" value="priority" /><span><strong>By priority</strong><small>Follows each model's priority number.</small></span></label>
              </fieldset>
              <div class="toggle-row">
                <span><strong>Match tasks to skills</strong><small>Sends coding to coders, design to designers, and keeps light work on light models.</small></span>
                <input id="smart-routing" type="checkbox" class="switch" aria-label="Match tasks to skills" />
              </div>
              <div class="toggle-row">
                <span><strong>Allow paid models</strong><small>Used only within the cost limit below.</small></span>
                <input id="allow-paid" type="checkbox" class="switch" aria-label="Allow paid models" />
              </div>
              <div class="reveal" id="paid-limit"><div><label class="narrow">Max cost per run ($)<input id="max-cost" type="number" min="0.001" max="100" step="any" required /></label></div></div>
              <label class="narrow">Default mode<select id="mode-select"><option value="auto">Auto</option><option value="quick">Quick</option><option value="reviewed">Reviewed</option><option value="deep">Deep</option></select></label>
              <details class="advanced">
                <summary>Fixed roles and instructions</summary>
                <p class="field-hint">Generator is used only when matching tasks to skills is off.</p>
                <div class="field-grid">
                  <label>Generator<select id="generator-id"></select></label>
                  <label>Planner<select id="planner-id"></select></label>
                  <label>Reviewer<select id="reviewer-id"></select></label>
                </div>
                <label>Instructions for every answer<textarea id="system-prompt" rows="3" maxlength="4000"></textarea></label>
              </details>
            </section>
            <section class="settings-panel" role="tabpanel" id="panel-search" aria-labelledby="tab-search" hidden>
              <div class="panel-intro"><p>Searches only when a request needs current information, then cites the pages it read.</p></div>
              <div class="field-grid">
                <label>When to search<select id="web-search"><option value="auto">When needed</option><option value="off">Never</option></select></label>
                <label>Pages to read<input id="search-pages" type="number" min="1" max="5" required /></label>
              </div>
              <label>SearXNG address<input id="search-url" type="url" placeholder="http://localhost:8888" /></label>
              <div class="form-actions start"><button type="button" class="secondary-button" id="test-search">Test search</button></div>
              <div class="toggle-row">
                <span><strong>Real photos for pages</strong><small>Finds openly licensed photos on Wikimedia Commons, checks that they load, and credits the photographers. No key needed.</small></span>
                <input id="page-photos" type="checkbox" class="switch" aria-label="Real photos for pages" />
              </div>
            </section>
            <section class="settings-panel" role="tabpanel" id="panel-limits" aria-labelledby="tab-limits" hidden>
              <div class="panel-intro"><p>Caps for each run. Failed calls still count, since the provider may have charged for them.</p></div>
              <div class="field-grid">
                <label>Model calls per run<input id="max-calls" type="number" min="1" max="20" required /></label>
                <label>Repair rounds<input id="max-repairs" type="number" min="0" max="3" required /></label>
                <label>Output tokens per call<input id="max-output-tokens" type="number" min="128" max="65536" required /></label>
                <label>Context tokens per call<input id="context-tokens" type="number" min="1024" max="1000000" required /></label>
                <label>Tokens per run<input id="token-budget" type="number" min="2048" max="2000000" required /></label>
                <label>Provider timeout (s)<input id="timeout-seconds" type="number" min="10" max="600" required /></label>
                <label>Run time limit (s)<input id="max-run-seconds" type="number" min="30" max="3600" required /></label>
              </div>
            </section>
            <div class="settings-save" id="settings-save" hidden>
              <p class="form-feedback" id="settings-feedback" role="status"></p>
              <button type="submit" class="primary-button">Save changes</button>
            </div>
          </form>
          <section class="settings-panel" role="tabpanel" id="panel-general" aria-labelledby="tab-general" hidden>
            <div class="settings-row">
              <label for="theme-select">Appearance</label>
              <select id="theme-select"><option value="dark">Dark</option><option value="light">Light</option></select>
            </div>
            <div class="settings-row"><span>Conversation history <small>Saved on your L.E.O. server</small></span><button class="secondary-button" id="clear-history">Clear</button></div>
            <div id="clear-confirmation" class="clear-confirmation" hidden>
              <p>Delete all conversations? This cannot be undone.</p>
              <div><button class="secondary-button" id="cancel-clear">Cancel</button><button class="secondary-button danger" id="confirm-clear">Delete all</button></div>
            </div>
            <details class="shortcuts">
              <summary>Keyboard shortcuts<Icon name="down" size={15} /></summary>
              <div class="shortcut-row"><span>New chat</span><kbd>⌘ / Ctrl + K</kbd></div>
              <div class="shortcut-row"><span>Search conversations</span><kbd>⌘ / Ctrl + /</kbd></div>
              <div class="shortcut-row"><span>Send message</span><kbd>Enter</kbd></div>
              <div class="shortcut-row"><span>New line</span><kbd>Shift + Enter</kbd></div>
            </details>
            <div class="settings-about"><strong>L.E.O</strong><span>LLM Efficiency Orchestrator</span><p>Provider keys are encrypted on your server. Messages are sent to the models you turn on. Chat subscriptions and API access are separate.</p></div>
          </section>
        </div>
      </div>
    </dialog>
    <dialog id="login-dialog" class="dialog" aria-labelledby="login-heading">
      <h2 id="login-heading">Connect to your server</h2>
      <p class="field-hint">This server requires an access token.</p>
      <form id="login-form"><label>Server access token<input id="access-token" type="password" required autocomplete="current-password" /></label><p id="login-feedback" class="form-feedback" role="status"></p><div class="form-actions"><button type="submit" class="primary-button">Connect</button></div></form>
    </dialog>
    <div id="toast" class="toast" role="status" hidden></div>
    <script src="../scripts/chat.ts"></script>
  </body>
</html>
